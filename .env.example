# ==============================================================================
# PIPFLOWTRADE.SITE — Environment Variables Template
# Copy to .env locally or configure in Render Dashboard -> Environment.
# NEVER commit real secrets to version control.
# ==============================================================================

# Server & URLs
NODE_ENV="development"
PORT="3000"
APP_URL="https://pipflowtrade.site"
FRONTEND_URL="https://pipflowtrade.site"
PUBLIC_SITE_URL="https://pipflowtrade.site"

# Independent Vercel Application Origins
BOT_APP_URL="https://bot.pipflowtrade.site"
TRADER_APP_URL="https://trader.pipflowtrade.site"
CHARTS_APP_URL="https://charts.pipflowtrade.site"
OPTIONS_APP_URL="https://options.pipflowtrade.site"

# PostgreSQL (Render Managed PostgreSQL)
# Leave blank in local/sandbox preview to use the encrypted local persistent store.
DATABASE_URL=""

# Deriv API & OAuth2 Credentials (from developers.deriv.com)
DERIV_APP_ID=""
DERIV_CLIENT_SECRET=""
DERIV_OAUTH_URL="https://oauth.deriv.com/oauth2/authorize"
DERIV_OAUTH_REDIRECT_URI="https://pipflowtrade.site/api/deriv/callback"
DERIV_OAUTH_SCOPE="read,trade,trading_information,payments"
DERIV_WS_URL="wss://ws.derivws.com/websockets/v3"

# Central Authentication, SSO & Token Encryption
# Generate 32+ byte random hex/base64 strings for production
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
SSO_SIGNING_SECRET=""
TOKEN_ENCRYPTION_KEY=""

# Server-Side Super Admin Bootstrap (Optional — never expose in client bundles)
# Used exclusively on initial boot when administrator_accounts has no SUPER_ADMIN
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_MFA_SECRET=""

# Transactional Email (Optional — e.g., Brevo / SMTP)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@pipflowtrade.site"
BREVO_SENDER_NAME="PIPFLOWTRADE.SITE"

# Gemini API (Optional AI strategy assistant if explicitly enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
