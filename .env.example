# ==============================================================================
# PIPFLOWTRADE.SITE — Render Environment Variables Template
# Matches your existing Render service environment keys.
# NEVER commit real secrets to version control.
# ==============================================================================

NODE_ENV="production"
PORT="3000"

# Site & App URLs
APP_URL="https://pipflowtrade.site"
FRONTEND_URL="https://pipflowtrade.site"
PUBLIC_SITE_URL="https://pipflowtrade.site"
VITE_API_URL="https://pipflowtrade.site"

# Independent Vercel Application Origins (default to *.pipflowtrade.site if omitted)
BOT_APP_URL="https://bot.pipflowtrade.site"
TRADER_APP_URL="https://trader.pipflowtrade.site"
CHARTS_APP_URL="https://charts.pipflowtrade.site"
OPTIONS_APP_URL="https://options.pipflowtrade.site"

# PostgreSQL (Render Managed PostgreSQL Internal/External URL)
DATABASE_URL=""

# Deriv API & OAuth2 Credentials (from https://developers.deriv.com)
DERIV_APP_ID=""
DERIV_API_KEY=""
DERIV_ADMIN_TOKEN=""
DERIV_ENV="prod"
DERIV_OAUTH_URL="https://auth.deriv.com/oauth2/auth"
DERIV_OAUTH_REDIRECT_URI="https://pipflowtrade.site/api/deriv/oauth/callback"
DERIV_OAUTH_SCOPE="trade"
DERIV_WS_URL="wss://api.derivws.com/trading/v1/options/ws/public"
VITE_DERIV_APP_ID=""
VITE_WS_URL="wss://api.derivws.com/trading/v1/options/ws/public"

# Central Authentication, SSO & Encryption
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BOT_GATE_JWT_SECRET=""
SSO_SIGNING_SECRET=""
TOKEN_ENCRYPTION_KEY=""

# Server-Side Private Administrator Credentials
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PRIVATE_SLUG=""
ADMIN_MFA_SECRET=""

# Transactional Email (Brevo)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@pipflowtrade.site"
BREVO_SENDER_NAME="PIPFLOWTRADE.SITE"

# Gemini API
GEMINI_API_KEY="MY_GEMINI_API_KEY"
